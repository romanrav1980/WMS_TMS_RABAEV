      "sql_sample": "update RRL_PICK_WAVE_REPLENISH_TASK set                     REPLENISHMENT_METHOD='IMMEDIATE',REPLENISHMENT_QTY_MODE='FILL_TO_VOLUME',                     QTY=(select l.PLANNED_QTY-l.PICKED_QTY from RRL_CASE_PICK_SHORT sh join RRL_CASE_PICK_LINE l on l.CASE_PICK_LINE_ID=sh.CASE_PICK_LINE_ID where sh.REPLENISH_TASK_ID=RRL_PICK_WAVE_REPLENISH_TASK.PICK_WAVE_REPLENISH_TASK_ID),                     STATUS=case when STATUS in('FAILED','WAIT_FREE_CELL','WAIT_MINIMAX','QUEUED') and SOURCE_RESERVATION_ID is null then 'RELEASED' else STATUS end                     where PICK_WAVE_REPLENISH_TASK_ID=:repl_id"
    },
