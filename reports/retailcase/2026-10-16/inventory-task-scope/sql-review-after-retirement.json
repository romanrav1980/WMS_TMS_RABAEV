      "avg_buffers": 5.27,
      "sql_sample": "select wt.TASK_ID,wt.STATUS,wt.ASSIGNED_TO         from RRL_CASE_PICK_SHORT sh join RRL_WAREHOUSE_TASK wt          on wt.TASK_SOURCE='WAVE' and wt.TASK_TYPE='REPLENISHMENT'           and wt.SOURCE_TASK_ID=sh.REPLENISH_TASK_ID         where sh.CASE_PICK_SHORT_ID=:short_id and sh.RECOVERY_STATE='WAIT_REPLENISHMENT'          and wt.PRIORITY=0 and wt.STATUS in('PLANNED','ASSIGNED','IN_PROGRESS')         order by wt.TASK_ID fetch first 1 row only"
