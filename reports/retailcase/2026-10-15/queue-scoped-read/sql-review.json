      "sql_sample": "select * from (select it.INVENTORY_TASK_ID,it.STATUS,it.WARE_ID WAREHOUSE_ID,it.CELL_CODE CELL,     it.ARTICUL ARTICLE,it.ASSIGNED_TO,it.PRIORITY,it.REVISION_ID,it.COUNT_OPERATION_ID,     sh.CASE_PICK_SHORT_ID SHORT_ID,sh.RECOVERY_STATE,sh.RECOVERY_DEADLINE_AT,     to_char(it.FACT_QTY,'TM9','NLS_NUMERIC_CHARACTERS=''.,''') FACT_QUANTITY     from RRL_INVENTORY_TASK it left join RRL_CASE_PICK_SHORT sh on sh.CASE_PICK_SHORT_ID=it.SOURCE_DOC_ID     and it.SOURCE_DOC_TYPE='CASE_PICK_SHORT'                 where ((:task_id is not null and it.INVENTORY_TASK_ID=:task_id)                    or (:task_id is null and it.STATUS in('NEW','ASSIGNED','IN_PROGRESS')))                 and (:ware is null or it.WARE_ID=:ware) and it.WARE_ID is not null                 and RRL_ACCESS_API.allowed(:actor,'inventory_task_view','WAREHOUSE',to_char(it.WARE_ID))=1                 order by it.PRIORITY,it.CREATED_A"
