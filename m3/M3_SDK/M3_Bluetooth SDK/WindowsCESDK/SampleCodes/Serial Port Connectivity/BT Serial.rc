/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_BTSERIAL_DIALOG DIALOG DISCARDABLE  0, 0, 144, 162
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW | 0x80000000L
CAPTION "BT Serial"
FONT 8, "System"
BEGIN
    CONTROL         "List1",IDC_LIST1,"SysListView32",LVS_REPORT | WS_BORDER | 
                    WS_TABSTOP,3,52,133,71
    PUSHBUTTON      "Bluetooth ON",IDC_BUTTON1,3,39,67,13
    PUSHBUTTON      "BT Neighbourhood",IDC_BUTTON2,70,39,66,13
    PUSHBUTTON      "Service Search",IDC_BUTTON3,3,124,67,13
    PUSHBUTTON      "SPP  Connect",IDC_BUTTON4,70,124,66,13,BS_MULTILINE
    EDITTEXT        IDC_STATUS,5,143,132,12,ES_AUTOHSCROLL | NOT WS_BORDER
    CONTROL         "Server",IDC_CHECK1,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,2,24,38,15
    CTEXT           "Bluetooth",IDC_STATIC,35,6,71,8
    CTEXT           "Serial Application",IDC_STATIC,35,15,71,8
END


