IDD_GSMCOREDEMO_DIALOG DIALOGEX 0, 0, 160, 167
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW | 0x80000000L
CAPTION "GSMCoreDemo"
FONT 8, "Tahoma"
BEGIN
    PUSHBUTTON      "GetGSMTime",IDC_BTN_GSM_TIME,1,17,55,13
    CTEXT           "",IDC_STATIC_TIME,58,17,99,13,SS_CENTERIMAGE | 
                    WS_BORDER
    PUSHBUTTON      "GetRSSI",IDC_BTN_GET_RSSI,1,1,55,13
    CTEXT           "",IDC_STATIC_RSSI,58,1,99,13,SS_CENTERIMAGE | WS_BORDER
    PUSHBUTTON      "GetIMEI",IDC_BTN_IMEI,1,33,55,13
    CTEXT           "",IDC_STATIC_IMEI,58,33,99,13,SS_CENTERIMAGE | 
                    WS_BORDER
    PUSHBUTTON      "Telephony / SMS",IDC_BTN_CALL_SMS,1,138,158,14
    PUSHBUTTON      "RAS / Phone Book",IDC_BTN_RAS_PB,1,153,158,14
    PUSHBUTTON      "SIM State",IDC_BTN_SIM_STATE,1,49,55,13
    CTEXT           "",IDC_STATIC_SIM_STATE,58,49,99,13,SS_CENTERIMAGE | 
                    WS_BORDER
    PUSHBUTTON      "Enter SIM PIN",IDC_BTN_ENTER_SIM,58,79,99,13
    PUSHBUTTON      "Enter SIM PUK",IDC_BTN_ENTER_PUK,58,121,99,13
    EDITTEXT        IDC_EDIT_SIM_PIN,58,65,99,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_SIM_PUK,58,92,99,14,ES_AUTOHSCROLL
    LTEXT           "SIM Pin",IDC_STATIC,5,68,54,8
    LTEXT           "SIM PUK",IDC_STATIC,6,95,28,8
    EDITTEXT        IDC_EDIT_NEW_PIN,58,107,99,14,ES_AUTOHSCROLL
    LTEXT           "New PIN",IDC_STATIC,6,110,28,8
END

IDD_DLG_CALL_SMS DIALOG DISCARDABLE  0, 0, 160, 163
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Telephony/SMS"
FONT 8, "Tahoma"
BEGIN
    LTEXT           "Phone Number",IDC_STATIC,9,12,48,8
    EDITTEXT        IDC_EDIT_CALL_PHONE_NUM,59,10,89,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Make Call",IDC_MAKE_CALL,9,24,69,11
    PUSHBUTTON      "End Call",IDC_END_CALL,79,24,69,11
    LTEXT           "DTMF String",IDC_STATIC,9,40,48,8
    EDITTEXT        IDC_EDIT_DTMF_STRING,59,39,89,12,ES_AUTOHSCROLL
    PUSHBUTTON      "DTMF Send",IDC_DTMF_SEND,59,52,89,11
    LTEXT           "Phone Number",IDC_STATIC,9,80,48,8
    EDITTEXT        IDC_EDIT_SMS_PHONE_NUM,59,78,89,12,ES_AUTOHSCROLL
    LTEXT           "Data",IDC_STATIC,9,91,16,8
    EDITTEXT        IDC_EDIT_SMS_DATA,30,92,118,35,ES_MULTILINE | 
                    ES_AUTOHSCROLL
    PUSHBUTTON      "SMS Send",IDC_SMS_SEND,79,129,69,11
    GROUPBOX        "Telephony",IDC_STATIC,3,1,152,66
    GROUPBOX        "SMS",IDC_STATIC,3,70,152,74
END

IDD_DLG_RAS_PB DIALOG DISCARDABLE  0, 0, 160, 166
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RAS / Phone Book"
FONT 8, "Tahoma"
BEGIN
    PUSHBUTTON      "CreateRasEntry",IDC_BTN_CREATE_RAS_ENTRY,14,10,131,12
    PUSHBUTTON      "RAS Connect",IDC_BTN_RAS_CONNECT,14,23,131,12
    PUSHBUTTON      "RAS HangUp",IDC_BTN_RAS_HANG_UP,14,36,131,12
    LTEXT           "Index",IDC_STATIC,13,68,20,8
    LTEXT           "Phone Number",IDC_STATIC,15,81,48,8
    EDITTEXT        IDC_EDIT_INDEX,73,65,75,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_PHONE_NUM,73,80,75,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_NAME,73,94,75,12,ES_AUTOHSCROLL
    LTEXT           "Name",IDC_STATIC,15,97,19,8
    PUSHBUTTON      "Write",IDC_BTN_WRITE,14,109,131,12
    PUSHBUTTON      "Read",IDC_BTN_READ,14,122,131,12
    PUSHBUTTON      "Delete",IDC_BTN_DEL,14,135,131,12
    LTEXT           "",IDC_STATIC_RESULT,0,155,160,11,SS_CENTERIMAGE
    GROUPBOX        "RAS",IDC_STATIC,4,0,152,52
    GROUPBOX        "Phone Book",IDC_STATIC,4,56,152,96
END


