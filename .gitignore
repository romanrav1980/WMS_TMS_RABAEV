*.7z
*.zip
*.rar
*.cab
*.iso
*.bak
*.dmp
*.dump
*.DMP
*.dat
*.DAT

# Large Oracle/database files over GitHub 100MB limit
data30.sql
OracleXEUniv.exe
db/restore_points/
**/Создание нового РЦ.sql
**/Заполнить все паллеты.sql

# -------------------------------------------------------
# SAP integration — runtime temp files and logs
# -------------------------------------------------------
# SAP_INTEGRATION is intentionally local-only.
SAP_INTEGRATION/

# -------------------------------------------------------
# Inaccessible / permission-denied directories
# -------------------------------------------------------
sap_oracle_python_test_0jk_lzve/

# -------------------------------------------------------
# Claude Code local settings (machine-specific permissions)
# -------------------------------------------------------
.claude/

# -------------------------------------------------------
# Local operational traces
# -------------------------------------------------------
tmp/
tmp-ssh/
sqlnet.log
*.log
api/wms_api_server/runtime/
runtime/test-evidence/
tests/load/**/report.json
exchange/production_release/in/*
exchange/production_release/processing/*
exchange/production_release/archive/*
exchange/production_release/error/*
exchange/production_release/out/*
!exchange/production_release/README.md
!exchange/production_release/**/.gitkeep
desktop.ini
Thumbs.db

