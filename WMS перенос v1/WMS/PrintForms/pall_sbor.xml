TRANSPORT_TASK.RRL_PALLETS_STR(  ST_NUMBER  ) PALLETS_STR 

 from  RABAEV.RRL_SBORKA_PALLETS NAK where   NAK.PALLET_UID = '[zakaz_id]' and rownum=1
</VAR>



