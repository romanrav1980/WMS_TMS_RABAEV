<TABLE y='212' x='20' name='table_1' rows_table_limit='15' yrepeat='30' xrepeat='30' font='17'  >
<SQL limit='400'  yrepeat='30' xrepeat='28'  >  

select rownum , ARTICUL , SHORTNAME , QT2   , COMPL.RRL_COUNT_KOR4( RSID  ) kor, 

COMPL.filter_show_weight_brutto( ORDER_WEIGHT , ARTICUL) ORDER_WEIGHT,

 '' fakt_br , '' fakt_kor , '' n_pall ,
 RRL_GET_MOD_INFO( CURRENT_MOD_ID ) CURRENT_MOD_ID , QT
 
from ( select RS.ID RSID  , RS.ARTICUL , RS.SHORTNAME , (ORDER_WEIGHT) ORDER_WEIGHT ,  (RS.QUANTITY) QT ,  (SORTFIELD) as sort1
 ,  CURRENT_MOD_ID  ,    ORDERS.get_ordered_qty( RS.ORIGINAL_QUANTITY , NAK.ORIGINAL_ST_NUMBER , RS.ARTICUL ) QT2
from  RABAEV.RRL_SBORKA_PALLETS NAK ,
RABAEV.RRL_SBORKA_PALLET_ROWS RS 
 where   NAK.PALLET_UID= '[zakaz_id]'  
 and NAK.PALLET_UID = RS.PALLET_UID  
 
order by (SORTFIELD) ) 

<FIELD name='rownum'   width='3' show='№'   ></FIELD>
<FIELD name='ARTICUL'  width='8' show='Артикул'   ></FIELD>
<FIELD name='SHORTNAME'  width='18' show='Наименование'   ></FIELD>
<FIELD name='QT'  width='3' show='Колв'  ></FIELD> 
<FIELD name='kor'  width='3' show='Кор'   ></FIELD>

<FIELD name='fakt_br'  width='4' show='Фбрутто'   ></FIELD>
<FIELD name='fakt_kor'  width='3' show='Фкор'   ></FIELD>
<FIELD name='n_pall'  width='3' show='№пал'   ></FIELD>

<FIELD name='ORDER_WEIGHT'   width='5' show='БРУТТО'   ></FIELD>

<FIELD name='CURRENT_MOD_ID'   width='8' show='ФАСОВКА'   ></FIELD>
<FIELD name='QT2'  width='5' show='Заказано'  ></FIELD> 


