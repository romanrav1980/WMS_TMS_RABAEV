<VAR name='id' >[nakl_id]</VAR>
<VAR name='head' type='sql' >select * from  RABAEV.RRL_SBORKA_PALLETS NAK where   NAK.PALLET_UID = '[pall_id]' and rownum=1 </VAR>


<VAR name='stat' type='sql' >
select count(  pts.quantity ) RS , sum( RABAEV.RRL_COUNT_KOR( articul , quantity ) ) KOR ,
round( sum( ORDER_WEIGHT ) , 2 ) OW
  from rrl_sborka_pallet_rows pts    
	where pts.pallet_uid ='[pall_id]'   
</VAR>




