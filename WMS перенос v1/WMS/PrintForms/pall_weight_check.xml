<TABLE y='212' x='20' name='table_1' rows_table_limit='30' yrepeat='30' xrepeat='30' font='13'  >

<SQL limit='400'  yrepeat='30' xrepeat='28'  >  

select 
	rownum , path1  , sobr , articul , shortname  , 
	OW , '' Факт , '' OS , RRL_GET_MOD_INFO(CURRENT_MOD_ID) MOD , 
	RRL_GET_MOD_EXPLAIN( row_id ) explain , 
	vlozennost , quantity  

from (
select  ID row_id,   compl.path(articul ,pallet_uid) path1 , pts.articul  , pts.shortname ,
COMPL.print_kolbasa_sobr( ei  , pts.quantity , COMPL.RRL_vlozennost(articul ) )  sobr  , 
pts.ei , COMPL.RRL_vlozennost(articul)  vlozennost ,  pts.quantity , RABAEV.RRL_COUNT_KOR( articul , quantity ) KOR ,
round( ORDER_WEIGHT , 2 ) OW , CURRENT_MOD_ID 
from rrl_sborka_pallet_rows pts    
where pts.pallet_uid ='[pall_id]'   order by ID )


