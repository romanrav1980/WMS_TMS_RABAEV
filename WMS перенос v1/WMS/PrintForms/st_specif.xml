<TABLE y='224' x='50' name='table_1' rows_table_limit='30' yrepeat='150' xrepeat='50' font='12'  >
<SQL limit='400'  yrepeat='150' xrepeat='50'  >  

select   ARTICUL , SHORTNAME , round( SUM( QT ) , 2 ) QT  , round( sum( www ) , 2 ) ORDER_WEIGHT
from ( select RS.ID RSID , RS.ORDER_WEIGHT www  , RS.ARTICUL , RS.SHORTNAME , (ORDER_WEIGHT) ORDER_WEIGHT ,  (RS.QUANTITY) QT ,  (SORTFIELD) as sort1
 ,  CURRENT_MOD_ID  
from  RABAEV.RRL_SBORKA_PALLETS NAK ,
RABAEV.RRL_SBORKA_PALLET_ROWS RS 
 where   NAK.ST_NUMBER='[order_id]'  
 and NAK.PALLET_UID = RS.PALLET_UID  ) 
 GROUP BY  ARTICUL , SHORTNAME 
 order by ( max(sort1))
 

<FIELD name='rownum'   width='3' show='№'   ></FIELD>
<FIELD name='ARTICUL'  width='8' show='Артикул'   ></FIELD>
<FIELD name='SHORTNAME'  width='20' show='Наименование'   ></FIELD>
<FIELD name='QT'  width='6' show='Нетто/ШТ' summ='1'  ></FIELD> 
<FIELD name='ORDER_WEIGHT'   width='6' show='БРУТТО'  summ='1' ></FIELD>


</SQL>
<TR>
	<TD></TD><TD>итого</TD>
