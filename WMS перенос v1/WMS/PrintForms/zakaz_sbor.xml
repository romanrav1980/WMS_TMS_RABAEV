<FIELD name='ARTICUL'  width='10' show='Артикул'   ></FIELD>
<FIELD name='SHORTNAME'  width='20' show='Наименование'   ></FIELD>

<FIELD name='QT'  width='7' show='Количество'  ></FIELD> 
<FIELD name='kor'  width='5' show='Коробок'   ></FIELD>
<FIELD name='fakt_br'  width='7' show='Факт брутто'   ></FIELD>
<FIELD name='fakt_kor'  width='7' show='Факт коробок'   ></FIELD>
<FIELD name='n_pall'  width='7' show='Номер паллета'   ></FIELD>
<FIELD name='ORDER_WEIGHT'   width='8' show='ВЕС БРУТТО'   ></FIELD>
<FIELD name='QT2'  width='7' show='ПервЗаказ'  ></FIELD> 

</SQL>
