<TABLE y='212' x='50' name='table_1' rows_table_limit='35' yrepeat='10' xrepeat='10'  >
<SQL limit='400'  yrepeat='10' xrepeat='10'  >  
select rownum , ARTICUL , SHORTNAME , QT   , COMPL.RRL_COUNT_KOR4( RSID  ) kor, 
COMPL.filter_show_weight_brutto( ORDER_WEIGHT , ARTICUL) ORDER_WEIGHT, '' fakt_br , '' fakt_kor , '' n_pall , QT2
from ( select RS.ID RSID  , RS.ARTICUL , RS.SHORTNAME , sum(ORDER_WEIGHT) ORDER_WEIGHT , sum(RS.QUANTITY) QT  , max(SORTFIELD) as sort1 ,sum(ORIGINAL_QUANTITY) QT2 
 from  RABAEV.RRL_SBORKA_PALLETS NAK ,
RABAEV.RRL_SBORKA_PALLET_ROWS RS 
 where   NAK.ST_NUMBER= '[zakaz_id]'  
 and NAK.PALLET_UID = RS.PALLET_UID  
group by RS.ARTICUL , RS.SHORTNAME , RS.ID 
order by max(SORTFIELD) ) where QT>0

