<BODY>
<VAR name='id' >[nakl_id]</VAR>
<VAR name='head' type='sql' >select * from  RABAEV.RRL_SBORKA_PALLETS NAK where   NAK.PALLET_UID = '[zakaz_id]' and rownum=1 </VAR>
<VAR name='vol' type='sql' > select  compl.perdiction_count_pall_not_full( '[order_id]' ) cp   from dual </VAR>


<VAR name='vol2' type='sql' > select  compl.perdiction_count_pall_only_ful( '[order_id]' ) cp   from dual </VAR>





<LOOP  from='1' to='[vol.CP]+1'  >
<PAGE axes='0' landscape='1' >
