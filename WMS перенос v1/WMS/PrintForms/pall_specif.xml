<LABEL  x='50' y='200'   >Фактический вес паллета: [head.TRIAL_WEIGHT]</LABEL>


<LABEL   x='650' y='120' type='EAN' encode='pallet_uid_code' width='200' height='80'  >[pall_id]</LABEL>


<TABLE y='224' x='50' name='table_1' rows_table_limit='30' yrepeat='150' xrepeat='50' font='12'  >
<SQL limit='400'  yrepeat='150' xrepeat='50'  >  

 select rownum , ARTICUL , SHORTNAME , EI , QT   , PACK_COUNT , 
 COMPL.filter_show_weight_brutto( ORDER_WEIGHT , ARTICUL) ORDER_WEIGHT,  compl.print_perc_defect( PRIHOD_PALLET_UID ) DEF_PRC ,
 COMPL.print_brutto_defect( PRIHOD_PALLET_UID  , ORDER_WEIGHT  ) DEF_WG , 
 RRL_GET_MOD_INFO( CURRENT_MOD_ID ) CURRENT_MOD_ID , IS_FULL_PALLET FP
from ( select RS.ID RSID  , RS.ARTICUL , RS.SHORTNAME , (ORDER_WEIGHT) ORDER_WEIGHT ,(RS.QUANTITY) QT , PACK_COUNT ,  (SORTFIELD) as sort1 ,  CURRENT_MOD_ID  , PRIHOD_PALLET_UID , EI , IS_FULL_PALLET
from  RABAEV.RRL_SBORKA_PALLETS NAK ,
RABAEV.RRL_SBORKA_PALLET_ROWS RS 
 where   NAK.PALLET_UID= '[pall_id]'  
 and NAK.PALLET_UID = RS.PALLET_UID  
 order by (SORTFIELD) ) 


<FIELD name='rownum'   width='3' show='№'   ></FIELD>
<FIELD name='ARTICUL'  width='8' show='Артикул'   ></FIELD>
<FIELD name='SHORTNAME'  width='20' show='Наименование'   ></FIELD>
<FIELD name='QT'  width='3' show='Нетто/ШТ'  ></FIELD> 
<FIELD name='PACK_COUNT'  width='3' show='Кор'   ></FIELD>
<FIELD name='ORDER_WEIGHT'   width='5' show='БРУТТО'   ></FIELD>
<FIELD name='CURRENT_MOD_ID'   width='8' show='ФАСОВКА'   ></FIELD>
<FIELD name='DEF_WG'   width='5' show='Вес брака'   ></FIELD>
<FIELD name='DEF_PRC'   width='5' show='%брака'   ></FIELD>

<FIELD name='FP'   width='4' show='ПАЛЛ'   >
</FIELD>



</SQL>
</TABLE>


