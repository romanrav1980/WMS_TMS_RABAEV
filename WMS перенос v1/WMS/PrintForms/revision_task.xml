<FIELD name='REMARK1'   width='14' show='Примечание'   ></FIELD>
<FIELD name='ARTICUL1'   width='8' show='Артикул'   ></FIELD>
<FIELD name='NUM_OF_PALL'   width='6' show='КолПалл'   ></FIELD>
