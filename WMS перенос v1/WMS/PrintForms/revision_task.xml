<TABLE y='90' x='50' name='table_1' rows_table_limit='34' yrepeat='50' xrepeat='50' font='14'  >
<SQL limit='400'  yrepeat='10' xrepeat='10'  >  

select   RR.ID,RR.CELL , RR.COUNT1, COUNT_KOR, REMARK1 
 , CEL.X , CEL.Y , CEL.Z , RR.ARTICUL1   , REVIZION.articul_name( RR.ARTICUL1) artname,  RR.NUM_OF_PALL
 from RABAEV.RRL_REVISION_ROW RR , RRL_CELLS CEL
 where RR.CELL=CEL.CELL and REVISION_ID= [rev_id] order by CEL.Z , CEL.Y , CEL.X 
 

