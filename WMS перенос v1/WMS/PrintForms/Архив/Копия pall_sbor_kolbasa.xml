<FIELD name='EI'  width='3' show='ЕИ'   >


	<IF condition='[EI]=кг' >
		<BOXES width='90' height='30' count='[KOR]' padding='5' ylimit='800' ></BOXES>
	</IF>
	
	<IF condition='[ARTICUL]=Т0000080256' >
		<BOXES width='90' height='30' count='[KOR]' padding='5' ylimit='800' ></BOXES>
	</IF>

 
</FIELD>





