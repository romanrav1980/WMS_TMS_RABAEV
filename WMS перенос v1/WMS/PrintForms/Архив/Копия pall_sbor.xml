<SQL limit='400'  yrepeat='10' xrepeat='10'  >  

select rownum , ARTICUL , SHORTNAME , QT   , COMPL.RRL_COUNT_KOR4( RSID  ) kor, 
COMPL.filter_show_weight_brutto( ORDER_WEIGHT , ARTICUL) ORDER_WEIGHT, '' fakt_br , '' fakt_kor , '' n_pall ,
 RRL_GET_MOD_INFO( CURRENT_MOD_ID ) CURRENT_MOD_ID 
 

from ( select RS.ID RSID  , RS.ARTICUL , RS.SHORTNAME , (ORDER_WEIGHT) ORDER_WEIGHT ,  (RS.QUANTITY) QT ,  (SORTFIELD) as sort1
 ,  CURRENT_MOD_ID  
from  RABAEV.RRL_SBORKA_PALLETS NAK ,
RABAEV.RRL_SBORKA_PALLET_ROWS RS 
 where   NAK.PALLET_UID= '[zakaz_id]'  
 and NAK.PALLET_UID = RS.PALLET_UID  
 
order by (SORTFIELD) ) 

