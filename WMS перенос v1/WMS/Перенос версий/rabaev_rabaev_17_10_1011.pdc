-------------------------
--  New function max2  --
-------------------------
CREATE OR REPLACE FUNCTION max2(
par1 number ,
par2 number
 )
 RETURN number 
 IS 
 
BEGIN
    if( par1 < par2  ) then
       RETURN par2;
       else
       RETURN par1;
          
    end if;
return 0;
END max2;
/

