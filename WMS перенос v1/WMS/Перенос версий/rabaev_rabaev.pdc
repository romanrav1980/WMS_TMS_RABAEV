create or replace package body CROSS_DOCKING is

function SYNC_ARTICUL(  ARTICUL1 VARCHAR2  , NORMA_UKLADKI1 number, CELL1 VARCHAR2 , 
  NAME1 VARCHAR2 , COUNT_SHT_IN_KOR1 number , CARTON_WEIGHT1 number , UNIT_TYPE1  VARCHAR2   , 
    BARCODE_SHT1 VARCHAR2 , BARCODE_KOR1 VARCHAR2 , AUTHOR_ID1 VARCHAR2 ) return int is

 tmp varchar2(255);
    
begin

    select acticul into tmp from rrl_articuls where acticul = ARTICUL1 ;
    return 1;
exception
  when no_data_found then

  insert into rrl_articuls 
  (  acticul   , NORMA_UKLADKI , CELL , NAME ,
    COUNT_SHT_IN_KOR  , CARTON_WEIGHT , UNIT_TYPE     , 
    BARCODE_SHT  , BARCODE_KOR  , AUTHOR_ID )   values 
    ( ARTICUL1   , NORMA_UKLADKI1 , CELL1 , NAME1 ,
    COUNT_SHT_IN_KOR1  , CARTON_WEIGHT1 , UNIT_TYPE1     , 
    BARCODE_SHT1  , BARCODE_KOR1   , 'CROSS_DOCK'
   );   
   return 1;  
 null;
end;

