BEFORE UPDATE
OF CURRENT_MOD_ID
ON RABAEV.RRL_SBORKA_PALLET_ROWS 
REFERENCING NEW AS NEW OLD AS OLD
FOR EACH ROW
DECLARE
var1 int;
BEGIN

--v int;
            
       --   if(  :new.CURRENT_MOD_ID   <> 0) and ( not :new.CURRENT_MOD_ID is null  ) then
       --         :new.ORDER_WEIGHT:= round( :new.ORIGINAL_ORDER_WEIGHT*( :new.QUANTITY / :new.original_quantity) , 4) +
       --             RRL_CARTON_WEIGHT2( :new.ARTICUL , :new.QUANTITY , :new.CURRENT_MOD_ID ); 
       --     else
       --          :new.ORDER_WEIGHT:= round( :new.ORIGINAL_ORDER_WEIGHT*( :new.QUANTITY / :new.original_quantity) , 4) ;
       --   end if;
        
        
       begin
       
       select art.type_w into var1 from rrl_articuls art   where      art.acticul=:new.ARTICUL and art.type_w in (0,1) ;
       
         if(  :new.CURRENT_MOD_ID   <> 0) and ( not :new.CURRENT_MOD_ID is null  ) then
                :new.ORDER_WEIGHT:= round( :new.ORIGINAL_ORDER_WEIGHT*( :new.QUANTITY / :new.original_quantity) , 4) +
                    RRL_CARTON_WEIGHT2( :new.ARTICUL , :new.QUANTITY , :new.CURRENT_MOD_ID ); 
            else
                 :new.ORDER_WEIGHT:= round( :new.ORIGINAL_ORDER_WEIGHT*( :new.QUANTITY / :new.original_quantity) , 4) ;
          end if;
       
       
       
       exception when no_data_found then null;
       when others then null;
       
       end;
                      
         null;
  
  
END;
