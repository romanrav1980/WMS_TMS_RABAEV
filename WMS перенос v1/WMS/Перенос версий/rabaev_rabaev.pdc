-------------------------------
--  New function tabel_pipe  --
-------------------------------
create or replace function tabel_pipe( pi_date date
                                            , pi_wares varchar2 ) return tbl_tabel pipelined
as
  --
  v_tabel t_tabel := t_tabel( null, null, null, null, null, null, null, null, null, null
                            , null, null, null, null, null, null, null, null, null, null
                            , null, null, null, null, null, null, null, null, null, null
                            , null, null, null, null, null, null, null );
  v_start_date date;
  v_end_date   date;
  --
begin
  v_start_date := trunc(pi_date, 'mm');
  v_end_date := last_day(pi_date);
  for rec
  in (  select sborshik
             , rrl_get_user_info(sborshik) fio
             , sum(decode(dn, 0, rday, 0)) day_01
             , sum(decode(dn, 1, rday, 0)) day_02
             , sum(decode(dn, 2, rday, 0)) day_03
             , sum(decode(dn, 3, rday, 0)) day_04
             , sum(decode(dn, 4, rday, 0)) day_05
             , sum(decode(dn, 5, rday, 0)) day_06
             , sum(decode(dn, 6, rday, 0)) day_07
             , sum(decode(dn, 7, rday, 0)) day_08
             , sum(decode(dn, 8, rday, 0)) day_09
             , sum(decode(dn, 9, rday, 0)) day_10
             , sum(decode(dn, 10, rday, 0)) day_11
             , sum(decode(dn, 11, rday, 0)) day_12
             , sum(decode(dn, 12, rday, 0)) day_13
             , sum(decode(dn, 13, rday, 0)) day_14
             , sum(decode(dn, 14, rday, 0)) day_15
             , sum(decode(dn, 15, rday, 0)) day_16
             , sum(decode(dn, 16, rday, 0)) day_17
             , sum(decode(dn, 17, rday, 0)) day_18
             , sum(decode(dn, 18, rday, 0)) day_19
             , sum(decode(dn, 19, rday, 0)) day_20
             , sum(decode(dn, 20, rday, 0)) day_21
             , sum(decode(dn, 21, rday, 0)) day_22
             , sum(decode(dn, 22, rday, 0)) day_23
             , sum(decode(dn, 23, rday, 0)) day_24
             , sum(decode(dn, 24, rday, 0)) day_25
             , sum(decode(dn, 25, rday, 0)) day_26
             , sum(decode(dn, 26, rday, 0)) day_27
             , sum(decode(dn, 27, rday, 0)) day_28
             , sum(decode(dn, 28, rday, 0)) day_29
             , sum(decode(dn, 29, rday, 0)) day_30
             , sum(decode(dn, 30, rday, 0)) day_31
             , sum(decode(rday, 0, 0, 1)) day
             , sum(rday) cnt
             , decode(pi_wares, 'ОВОЩИ', tabel_get_sum(sum(rday), pi_wares) -- тоннаж считается за месяц
                              , 'АРБУЗ', tabel_get_sum(sum(rday), pi_wares) -- тоннаж считается за месяц
                              , 'ЛУК', tabel_get_sum(sum(rday), pi_wares)   -- тоннаж считается за месяц
                              , sum(mday)) sum_money                        -- все остальное за день
          from (  select p.sborshik
                       , case
                           when p.checking_time <= to_date(to_char(trunc(p.checking_time, 'dd'), 'dd.mm.yyyy') || ' 07:59:59', 'dd.mm.yyyy hh24:mi:ss')
                           then
                             trunc(p.checking_time - 1, 'dd') - v_start_date
                           else
                             trunc(p.checking_time) - v_start_date
                         end dn
                       , decode(pi_wares, 'МЕЗ', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                        , 'АЛКО', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                        , 'ПРОМ', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                        , 'ХОЛОД', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                        , 'ГИПЕР', sum(rabaev.rrl_pal_kor_count(p.pallet_uid))
                                        , 'СУХОЙ', sum(rabaev.rrl_pal_kor_count(p.pallet_uid))
                                        , 'ОВОЩИ', sum(rabaev.rrl_pallet_weight(p.pallet_uid))/1000
                                        , 'АРБУЗ', sum(rabaev.rrl_pallet_weight(p.pallet_uid))/1000
                                        , 'ЛУК', sum(rabaev.rrl_pallet_weight(p.pallet_uid))/1000
                                        , 0) rday
                       , tabel_get_sum(decode(pi_wares, 'МЕЗ', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                                      , 'АЛКО', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                                      , 'ПРОМ', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                                      , 'ХОЛОД', sum(rabaev.rrl_pal_row_count(p.pallet_uid))
                                                      , 'ГИПЕР', sum(rabaev.rrl_pal_kor_count(p.pallet_uid))
                                                      , 'СУХОЙ', sum(rabaev.rrl_pal_kor_count(p.pallet_uid))
                                                      , 0 --'ОВОЩИ', sum(rabaev.rrl_pallet_weight(p.pallet_uid))/1000 -- тоннаж считаем за месяц
                                                      , 0 --'АРБУЗ', sum(rabaev.rrl_pallet_weight(p.pallet_uid))/1000 -- тоннаж считаем за месяц
                                                      , 0 --'ЛУК', sum(rabaev.rrl_pallet_weight(p.pallet_uid))/1000   -- тоннаж считаем за месяц
                                                      , 0), pi_wares) mday
                    from rrl_sborka_pallets p
                       , rusers u
                       , rrl_wares w
                   where p.sborshik = u.id
                     and u.ware_id = w.id
                     and u.user_group = 'SBORSHIK'
                     and (   pi_wares not in ('ОВОЩИ', 'АРБУЗ', 'ЛУК') and w.name = pi_wares -- в группу ОВОЩИ входят ОВОЩИ, АРБУЗ, ЛУК
                          or pi_wares in ('ОВОЩИ', 'АРБУЗ', 'ЛУК') and w.name in ('ОВОЩИ', 'АРБУЗ', 'ЛУК'))
                     and p.checking_time between to_date(to_char(v_start_date, 'dd.mm.yyyy') || ' 08:00:00', 'dd.mm.yyyy hh24:mi:ss')
                                             and to_date(to_char(v_end_date + 1, 'dd.mm.yyyy') || ' 07:59:59', 'dd.mm.yyyy hh24:mi:ss')
                group by p.sborshik
                       , case
                           when p.checking_time <= to_date(to_char(trunc(p.checking_time, 'dd'), 'dd.mm.yyyy') || ' 07:59:59', 'dd.mm.yyyy hh24:mi:ss')
                           then
                             trunc(p.checking_time - 1, 'dd') - v_start_date
                           else
                             trunc(p.checking_time) - v_start_date
                         end)
      group by sborshik
      order by rrl_get_user_info(sborshik))
  loop
    begin
      select tabel_no
           , name
        into v_tabel.tabel_no
           , v_tabel.company
        from rcompany c
           , ruser_tabel t
       where c.inn = t.inn
         and t.user_id = rec.sborshik;
    exception
      when no_data_found then
        null;
    end;
    if rec.fio = ' ' then
      rec.fio := null;
    end if;
    v_tabel.fio := nvl(rec.fio, rec.sborshik);
    v_tabel.day_01 := rec.day_01;
    v_tabel.day_02 := rec.day_02;
    v_tabel.day_03 := rec.day_03;
    v_tabel.day_04 := rec.day_04;
    v_tabel.day_05 := rec.day_05;
    v_tabel.day_06 := rec.day_06;
    v_tabel.day_07 := rec.day_07;
    v_tabel.day_08 := rec.day_08;
    v_tabel.day_09 := rec.day_09;
    v_tabel.day_10 := rec.day_10;
    v_tabel.day_11 := rec.day_11;
    v_tabel.day_12 := rec.day_12;
    v_tabel.day_13 := rec.day_13;
    v_tabel.day_14 := rec.day_14;
    v_tabel.day_15 := rec.day_15;
    v_tabel.day_16 := rec.day_16;
    v_tabel.day_17 := rec.day_17;
    v_tabel.day_18 := rec.day_18;
    v_tabel.day_19 := rec.day_19;
    v_tabel.day_20 := rec.day_20;
    v_tabel.day_21 := rec.day_21;
    v_tabel.day_22 := rec.day_22;
    v_tabel.day_23 := rec.day_23;
    v_tabel.day_24 := rec.day_24;
    v_tabel.day_25 := rec.day_25;
    v_tabel.day_26 := rec.day_26;
    v_tabel.day_27 := rec.day_27;
    v_tabel.day_28 := rec.day_28;
    v_tabel.day_29 := rec.day_29;
    v_tabel.day_30 := rec.day_30;
    v_tabel.day_31 := rec.day_31;
    v_tabel.day := rec.day;
    v_tabel.cnt := rec.cnt;
    v_tabel.sum_money := rec.sum_money;
    --
    pipe row (v_tabel);
  end loop;
  return;
end;
/

