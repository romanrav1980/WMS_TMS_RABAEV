create or replace package body TOOLS is

   
  function maintain_cht  return int is

  event_time Date;
  pnumber1 varchar2(255);  
  cursor pts is select pppp.pallet_uid from rrl_sborka_pallets pppp 
         where pppp.create_date>to_date('01.06.2011') and event_time is null ;
  
  
  begin
    
           for  pp in pts loop      
           
               begin
                   select min(hist.time1) into event_time 
                        from rrl_sborka_pallets_history hist where hist.pallet_uid=pp.pallet_uid 
                        and zone='VESOV' and hist.event='WEIGHT_CHECK' ;
                      if( not event_time is null ) then
                          update rrl_sborka_pallets ppf set ppf.checking_time=event_time 
                                 where ppf.pallet_uid=pp.pallet_uid;
                          
                      end if; 
                   exception
                     when no_data_found then null;
                     when others then null;   
                end ;
                
           end loop;
           return 1;
  end;



