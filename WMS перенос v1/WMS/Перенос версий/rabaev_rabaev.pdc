-----------------------------
--  Changed function isif  --
-----------------------------
CREATE OR REPLACE FUNCTION isif(
par1 int ,
par2 int 
 )
 RETURN int 
 IS 
 

BEGIN
    

if( par1 is null ) then
   RETURN 0;   
end if;
if( par2 is null ) then
   RETURN 0;   
end if;

if( par1 = par2 ) then
   RETURN 1;   
end if;

return 0;

END isif;
/
-----------------------------
--  Changed function min2  --
-----------------------------
CREATE OR REPLACE FUNCTION min2(
par1 number ,
par2 number
 )
 RETURN number 
 IS 
 
BEGIN
    if( par1 > par2  ) then
       RETURN par2;
       else
       RETURN par1;
          
    end if;
return 0;
END min2;
/
