------------------------------
create or replace type t_avg_pallets as object (
    sklad varchar2(200)
  , day_01 number(9)
  , day_02 number(9)
  , day_03 number(9)
  , day_04 number(9)
  , day_05 number(9)
  , day_06 number(9)
  , day_07 number(9)
  , day_08 number(9)
  , day_09 number(9)
  , day_10 number(9)
  , day_11 number(9)
  , day_12 number(9)
  , day_13 number(9)
  , day_14 number(9)
  , day_15 number(9)
  , day_16 number(9)
  , day_17 number(9)
  , day_18 number(9)
  , day_19 number(9)
  , day_20 number(9)
  , day_21 number(9)
  , day_22 number(9)
  , day_23 number(9)
  , day_24 number(9)
  , day_25 number(9)
  , day_26 number(9)
  , day_27 number(9)
  , day_28 number(9)
  , day_29 number(9)
