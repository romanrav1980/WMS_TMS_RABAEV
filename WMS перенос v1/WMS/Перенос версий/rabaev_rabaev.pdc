   tmpVar := 0;
  
select count( R.ID  )  into tmpVar from RABAEV.RRL_SBORKA_PALLETS P , RABAEV.RRL_SBORKA_PALLET_ROWS R 
     where  P.ST_NUMBER   = ST and P.PALLET_UID =  R.PALLET_UID and R.QUANTITY>0  ;
 
