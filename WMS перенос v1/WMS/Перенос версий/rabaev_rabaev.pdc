--------------------------------
--  New type tbl_avg_pallets  --
--------------------------------
create or replace type tbl_avg_pallets as table of t_avg_pallets
/

-------------------------------------
--  New function avg_pallets_pipe  --
-------------------------------------
create or replace function avg_pallets_pipe return tbl_avg_pallets pipelined
as
  --
  v_avg_pallets t_avg_pallets := t_avg_pallets( null, null, null, null, null, null, null, null, null, null
                                              , null, null, null, null, null, null, null, null, null, null
                                              , null, null, null, null, null, null, null, null, null, null
                                              , null, null );
  v_start_date date;
  v_end_date   date;
  --
begin
  v_start_date := trunc(sysdate, 'mm');
  v_end_date := last_day(sysdate);
  for rec
  in (  select sklad
             , sum(decode(dn, 0, pday, 0)) day_01
             , sum(decode(dn, 1, pday, 0)) day_02
             , sum(decode(dn, 2, pday, 0)) day_03
             , sum(decode(dn, 3, pday, 0)) day_04
             , sum(decode(dn, 4, pday, 0)) day_05
             , sum(decode(dn, 5, pday, 0)) day_06
             , sum(decode(dn, 6, pday, 0)) day_07
             , sum(decode(dn, 7, pday, 0)) day_08
             , sum(decode(dn, 8, pday, 0)) day_09
             , sum(decode(dn, 9, pday, 0)) day_10
             , sum(decode(dn, 10, pday, 0)) day_11
             , sum(decode(dn, 11, pday, 0)) day_12
             , sum(decode(dn, 12, pday, 0)) day_13
             , sum(decode(dn, 13, pday, 0)) day_14
             , sum(decode(dn, 14, pday, 0)) day_15
             , sum(decode(dn, 15, pday, 0)) day_16
             , sum(decode(dn, 16, pday, 0)) day_17
             , sum(decode(dn, 17, pday, 0)) day_18
             , sum(decode(dn, 18, pday, 0)) day_19
             , sum(decode(dn, 19, pday, 0)) day_20
             , sum(decode(dn, 20, pday, 0)) day_21
             , sum(decode(dn, 21, pday, 0)) day_22
             , sum(decode(dn, 22, pday, 0)) day_23
             , sum(decode(dn, 23, pday, 0)) day_24
             , sum(decode(dn, 24, pday, 0)) day_25
             , sum(decode(dn, 25, pday, 0)) day_26
             , sum(decode(dn, 26, pday, 0)) day_27
             , sum(decode(dn, 27, pday, 0)) day_28
             , sum(decode(dn, 28, pday, 0)) day_29
             , sum(decode(dn, 29, pday, 0)) day_30
             , sum(decode(dn, 30, pday, 0)) day_31
          from (    select trunc(p.checking_time, 'dd') - v_start_date dn
                         , upper(w.name) sklad
                         , count( * ) pday
                      from rrl_sborka_pallets p
                         , rusers u
                         , rrl_wares w
                     where p.sborshik = u.id
                       and u.ware_id = w.id
                       and (p.prooved = 1 or p.prooved_by_scan = 1)
--                       and upper(w.name) in ('МЕЗ', 'АЛКО', 'ПРОМ', 'ХОЛОД')
                       and trunc(p.checking_time, 'dd') between v_start_date and v_end_date
                  group by upper(w.name)
                         , trunc(p.checking_time, 'dd') - v_start_date)
      group by sklad)
  loop
    v_avg_pallets.sklad := rec.sklad;
    v_avg_pallets.day_01 := rec.day_01;
    v_avg_pallets.day_02 := rec.day_02;
    v_avg_pallets.day_03 := rec.day_03;
    v_avg_pallets.day_04 := rec.day_04;
    v_avg_pallets.day_05 := rec.day_05;
    v_avg_pallets.day_06 := rec.day_06;
    v_avg_pallets.day_07 := rec.day_07;
    v_avg_pallets.day_08 := rec.day_08;
    v_avg_pallets.day_09 := rec.day_09;
    v_avg_pallets.day_10 := rec.day_10;
    v_avg_pallets.day_11 := rec.day_11;
    v_avg_pallets.day_12 := rec.day_12;
    v_avg_pallets.day_13 := rec.day_13;
    v_avg_pallets.day_14 := rec.day_14;
    v_avg_pallets.day_15 := rec.day_15;
    v_avg_pallets.day_16 := rec.day_16;
    v_avg_pallets.day_17 := rec.day_17;
    v_avg_pallets.day_18 := rec.day_18;
    v_avg_pallets.day_19 := rec.day_19;
    v_avg_pallets.day_20 := rec.day_20;
    v_avg_pallets.day_21 := rec.day_21;
    v_avg_pallets.day_22 := rec.day_22;
    v_avg_pallets.day_23 := rec.day_23;
    v_avg_pallets.day_24 := rec.day_24;
    v_avg_pallets.day_25 := rec.day_25;
    v_avg_pallets.day_26 := rec.day_26;
    v_avg_pallets.day_27 := rec.day_27;
    v_avg_pallets.day_28 := rec.day_28;
    v_avg_pallets.day_29 := rec.day_29;
    v_avg_pallets.day_30 := rec.day_30;
    v_avg_pallets.day_31 := rec.day_31;
    --
    pipe row (v_avg_pallets);
  end loop;
  return;
end;
/

-------------------------------------------------------
--  Changed function calc_timestamp_diff_in_seconds  --
-------------------------------------------------------
create or replace function CALC_TIMESTAMP_DIFF_IN_SECONDS (ts1 in timestamp, ts2 in timestamp)
           return number is total_secs number;
           diff interval day(9) to second(6);
       begin
       
       diff := ts2 - ts1;
       
       total_secs := abs(extract(second from diff) + extract(minute from diff)*60 + 
        extract(hour from diff)*60*60 +
        extract(day from diff)*24*60*60
        );
        
       return total_secs;
    end CALC_TIMESTAMP_DIFF_IN_SECONDS;
/
--------------------------------------------
--  Changed function ftime_shipping_plan  --
--------------------------------------------
CREATE OR REPLACE FUNCTION ftime_shipping_plan(
STDATE date ,
SHIPPING_TIME varchar2 
 )
 RETURN date
 --По дате создания накладной и плановому времени отгрузки возвращает плановое время-дата отгрузки
 IS 
 ret date;
 STDATE1 date;
 h_hours int;


BEGIN



    STDATE1:=STDATE;
    h_hours:=0;
    ret := STDATE;
    -- ЕСЛИ КОЛИЧЕСТВО ЧАСОВ > 12 , то  День отгрузки  = STDATE + 2 
    -- ЕСЛИ КОЛИЧЕСТВО ЧАСОВ <= 12 , то  День отгрузки  = STDATE + 1 
    
    if(   to_number( substr( SHIPPING_TIME  , 0 ,2 ) ) > 20 ) then 
        STDATE1:=  STDATE ;

    else
        STDATE1:=STDATE+1;

    end if;
    
    ret := to_date( concat ( to_char( STDATE1 ) , concat( ' ' , SHIPPING_TIME ) ) , 'dd.mm.yy HH24:MI'   ) ;
    
    
    
    
    
    return ret;

exception when others then return STDATE;



END ftime_shipping_plan;
/
